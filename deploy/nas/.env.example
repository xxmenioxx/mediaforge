# Image version published by a GitHub release. Avoid "latest" on a NAS.
MEDIAFORGE_VERSION=0.1.0
MEDIAFORGE_PORT=8090
TZ=America/Mexico_City

# Standalone NAS defaults. Change any path to match the NAS storage layout.
# Keeping the application under /volume1/docker/mediaforge follows the usual
# one-directory-per-Docker-application convention.
CONFIG_PATH=/volume1/docker/mediaforge/config
RAW_PATH=/volume1/docker/mediaforge/data/raw
LIBRARY_PATH=/volume1/docker/mediaforge/data/library
STAGING_PATH=/volume1/docker/mediaforge/data/staging
ARCHIVE_PATH=/volume1/docker/mediaforge/data/originals_archive
REPORTS_PATH=/volume1/docker/mediaforge/reports
