# Image version published by a GitHub release. Avoid "latest" on a NAS.
MVFORGE_VERSION=0.2.2
MVFORGE_PORT=8090
TZ=America/Mexico_City

# Standalone NAS defaults. Change any path to match the NAS storage layout.
# Keeping the application under /volume1/docker/mvforge follows the usual
# one-directory-per-Docker-application convention.
CONFIG_PATH=/volume1/docker/mvforge/config
RAW_PATH=/volume1/docker/mvforge/data/raw
STAGING_PATH=/volume1/docker/mvforge/data/staging
# Published libraries and the long-term originals archive can live on HDD.
# Replace /volume2/media with the actual media volume when it differs.
LIBRARY_PATH=/volume2/media
ARCHIVE_PATH=/volume2/media/mvforge/originals_archive
REPORTS_PATH=/volume1/docker/mvforge/reports
