# Image version published by a GitHub release. Avoid "latest" on a NAS.
MEDIAFORGE_VERSION=0.1.0
MEDIAFORGE_PORT=8090
TZ=America/Mexico_City

# Replace these examples with the actual absolute paths exposed by the NAS.
CONFIG_PATH=/volume1/mediaforge/config
RAW_PATH=/volume1/mediaforge/raw
LIBRARY_PATH=/volume1/mediaforge/library
STAGING_PATH=/volume1/mediaforge/staging
ARCHIVE_PATH=/volume1/mediaforge/originals_archive
REPORTS_PATH=/volume1/mediaforge/reports
